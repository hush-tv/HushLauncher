<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.hushtv.launcher">
    <!-- Only for the optional weather display; see Weather.java. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- For the Wi-Fi signal bars in the corner. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Only asked for when you choose "Add a picture" in the wallpaper gallery. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <!-- To find the VPN app that the corner VPN button should open. -->
        <intent><action android:name="android.net.VpnService" /></intent>
        <!-- To tell whether this is a Fire TV, where the Home redirect applies. -->
        <package android:name="com.amazon.tv.launcher" />
    </queries>
    <application android:label="Hush" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:allowBackup="true">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SaverPreview" android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <service android:name=".ClockDream" android:exported="true" android:label="Hush Launcher"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Fire TV only, and off until enabled as an accessibility service. See README. -->
        <service android:name=".HomeRedirectService" android:exported="true" android:label="Home button redirect"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_redirect" />
        </service>
    </application>
</manifest>
